{
  "name": "@jungle-grid/mcp",
  "version": "0.20.1",
  "description": "MCP server for Jungle Grid - submit and manage GPU workloads from any MCP-aware AI host",
  "license": "MIT",
  "homepage": "https://github.com/Jungle-Grid/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jungle-Grid/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Jungle-Grid/mcp-server/issues"
  },
  "keywords": [
    "jungle-grid",
    "mcp",
    "model-context-protocol",
    "gpu",
    "workloads",
    "ai-agents"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "junglegrid-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/auth.test.js dist/client.test.js dist/config.test.js dist/tools.test.js dist/index.test.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js --http"
  },
  "dependencies": {
    "@jungle-grid/gpu-registry": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "!dist/*.test.d.ts",
    "!dist/*.test.d.ts.map",
    "!dist/*.test.js",
    "!dist/*.test.js.map",
    "README.md",
    "LICENSE"
  ]
}
